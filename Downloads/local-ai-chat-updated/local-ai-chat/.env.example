# Copy to .env.local and adjust. Every value is optional; defaults are shown.

# Where Ollama is running, and which model to chat with (`ollama pull <model>`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Context window in tokens. Ollama's default is small and silently truncates long prompts.
OLLAMA_NUM_CTX=8192

# How long the model stays loaded in memory after a request ("30m", "1h", "-1" = forever)
OLLAMA_KEEP_ALIVE=30m

# Give up if Ollama sends nothing for this long (ms). Covers slow cold model loads.
OLLAMA_IDLE_TIMEOUT_MS=120000

# Only the latest N messages are sent to the model each turn
CHAT_HISTORY_LIMIT=20

# Limits
MAX_PDF_MB=10
MAX_PDF_CHARS=14000
MAX_MESSAGE_CHARS=8000

# SQLite database file (relative to the project root)
DB_PATH=data/chat.db
