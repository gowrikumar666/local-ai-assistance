"use client";
import React, { useState, useEffect, useRef } from 'react';
import { Plus, MessageSquare, Trash2, Send, Loader2, Bot, User, AlertCircle, X } from "lucide-react";
import { Avatar, Box, Button, IconButton, Divider, Drawer, ThemeProvider, Typography, createTheme, CssBaseline } from "@mui/material";

const theme = createTheme({
  palette: {
    primary: { main: "#ef6f61", contrastText: "#fffaf5" },
    secondary: { main: "#147d82" },
    background: { default: "#f8f4ee", paper: "#fffdfa" },
    text: { primary: "#1e2c36", secondary: "#71808a" },
  },
  typography: { fontFamily: "Arial, sans-serif", button: { textTransform: "none", fontWeight: 700 } },
  shape: { borderRadius: 16 },
});

export default function Home() {
  const [chats, setChats] = useState([]);
  const [activeChatId, setActiveChatId] = useState(null);
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState("");
  const [isLoading, setIsLoading] = useState(false);
  const [isChatsLoading, setIsChatsLoading] = useState(true);
  const [isMessagesLoading, setIsMessagesLoading] = useState(false);
  const [error, setError] = useState(null);
  const [mobileNavOpen, setMobileNavOpen] = useState(false);
  const messagesEndRef = useRef(null);

  useEffect(() => { fetchChats(); }, []);

  useEffect(() => {
    if (activeChatId) {
      fetchMessages(activeChatId);
    } else {
      setMessages([]);
    }
  }, [activeChatId]);

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  async function fetchChats() {
    setIsChatsLoading(true);
    try {
      const response = await fetch("/api/chats");
      const data = await response.json();
      setChats(Array.isArray(data) ? data : []);
    } catch (e) {
      setError("Unable to load your conversations.");
    } finally {
      setIsChatsLoading(false);
    }
  }

  async function fetchMessages(chatId) {
    setIsMessagesLoading(true);
    try {
      const response = await fetch(`/api/chats?chatId=${chatId}`);
      const data = await response.json();
      setMessages(Array.isArray(data) ? data : []);
    } catch (e) {
      setError("Unable to load this conversation.");
    } finally {
      setIsMessagesLoading(false);
    }
  }

  async function createNewChat() {
    try {
      const response = await fetch("/api/chats", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ title: "New conversation" }),
      });
      const newChat = await response.json();
      setChats((prev) => [newChat, ...prev]);
      setActiveChatId(newChat.id);
      setMessages([]);
      setMobileNavOpen(false);
    } catch (e) {
      setError("Unable to create a new conversation.");
    }
  }

  async function deleteChat(id, event) {
    event.stopPropagation();
    try {
      await fetch(`/api/chats?id=${id}`, { method: "DELETE" });
      setChats((prev) => prev.filter((chat) => chat.id !== id));
      if (activeChatId === id) setActiveChatId(null);
    } catch (e) {
      setError("Unable to delete this conversation.");
    }
  }

  async function handleSend() {
    if (!input.trim() || isLoading) return;
    setError(null);
    let currentChatId = activeChatId;
    const messageText = input.trim();
    setInput("");

    try {
      if (!currentChatId) {
        const response = await fetch("/api/chats", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ title: messageText.slice(0, 30) }),
        });
        const chat = await response.json();
        currentChatId = chat.id;
        setActiveChatId(chat.id);
        setChats((prev) => [chat, ...prev]);
      }
      setMessages((prev) => [...prev, { role: "user", content: messageText, createdAt: new Date().toISOString() }]);
      setIsLoading(true);
      const response = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ chatId: currentChatId, message: messageText }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "AI server error");
      setMessages((prev) => [...prev, { role: "assistant", content: data.content, createdAt: new Date().toISOString() }]);
    } catch (sendError) {
      const message = sendError instanceof Error ? sendError.message : "Something went wrong.";
      setError(message);
      setMessages((prev) => [...prev, { role: "assistant", content: `Error: ${message}`, createdAt: new Date().toISOString() }]);
    } finally {
      setIsLoading(false);
    }
  }

  const sidebar = (
    <Box sx={{ height: "100%", display: "flex", flexDirection: "column", bgcolor: "#172a35", color: "#fffaf5" }}>
      <Box sx={{ px: 3, pt: 3, pb: 2, display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box sx={{ display: 'flex', alignItems: 'center', gap: 1.5 }}>
          <Avatar sx={{ bgcolor: "primary.main", width: 36, height: 36, borderRadius: 2 }}><Bot size={19} /></Avatar>
          <Box>
            <Typography sx={{ fontWeight: 800, fontSize: 16, lineHeight: 1 }}>Morrow</Typography>
            <Typography sx={{ color: "#9db0b5", fontSize: 10, fontWeight: 700, letterSpacing: '0.05em' }}>LOCAL AI STUDIO</Typography>
          </Box>
        </Box>
        <IconButton onClick={() => setMobileNavOpen(false)} sx={{ color: "#9db0b5", display: { md: "none" } }}><X size={20} /></IconButton>
      </Box>
      <Box sx={{ px: 2, pb: 2 }}>
        <Button fullWidth variant="contained" startIcon={<Plus size={18} />} onClick={createNewChat} sx={{ justifyContent: "flex-start", px: 2, py: 1.4, boxShadow: "none" }}>New conversation</Button>
      </Box>
      <Typography sx={{ px: 3, pt: 1, pb: 1, color: "#769098", fontSize: 11, fontWeight: 800, letterSpacing: "0.1em" }}>YOUR SPACE</Typography>
      <Box sx={{ flex: 1, overflowY: "auto", px: 1.5 }}>
        {isChatsLoading ? (
          <Box sx={{ display: "flex", alignItems: "center", gap: 1, px: 1.5, py: 2, color: "#9db0b5" }}>
            <Loader2 size={16} className="animate-spin" />
            <Typography sx={{ fontSize: 13 }}>Loading chats...</Typography>
          </Box>
        ) : chats.length === 0 ? (
          <Typography sx={{ px: 1.5, py: 2, color: "#769098", fontSize: 13 }}>Your conversations will appear here.</Typography>
        ) : (
          chats.map((chat) => (
            <Box
              key={chat.id}
              onClick={() => { setActiveChatId(chat.id); setMobileNavOpen(false); }}
              sx={{
                display: "flex", alignItems: "center", px: 1.5, py: 1.25, mb: 0.5, borderRadius: 2, cursor: "pointer",
                bgcolor: activeChatId === chat.id ? "rgba(255,255,255,0.12)" : "transparent",
                color: activeChatId === chat.id ? "#fff" : "#b7c4c6",
                "&:hover": { bgcolor: "rgba(255,255,255,0.08)" }
              }}
            >
              <MessageSquare size={16} />
              <Typography noWrap sx={{ flex: 1, ml: 1.25, fontSize: 13 }}>{chat.title}</Typography>
              <IconButton size="small" onClick={(event) => deleteChat(chat.id, event)} sx={{ color: "#769098", p: 0.5, "&:hover": { color: "#ef6f61" } }}><Trash2 size={15} /></IconButton>
            </Box>
          ))
        )}
      </Box>
      <Box sx={{ p: 2.5 }}>
        <Divider sx={{ borderColor: "rgba(255,255,255,0.1)", mb: 2 }} />
        <Typography sx={{ color: "#9db0b5", fontSize: 12 }}>Private by design</Typography>
        <Typography sx={{ color: "#647e84", fontSize: 11, mt: 0.5 }}>Your chats stay on this device.</Typography>
      </Box>
    </Box>
  );

  return (
    <ThemeProvider theme={theme}>
      <CssBaseline />
      <Box sx={{ minHeight: "100dvh", display: "flex", bgcolor: "background.default" }}>
        <Box component="nav" sx={{ width: { md: 288 }, flexShrink: 0, display: { xs: "none", md: "block" } }}>{sidebar}</Box>
        <Drawer open={mobileNavOpen} onClose={() => setMobileNavOpen(false)} sx={{ display: { xs: "block", md: "none" }, "& .MuiDrawer-paper": { width: 288, border: 0 } }}>{sidebar}</Drawer>
        <Box component="main" sx={{ minWidth: 0, flex: 1, display: "flex", flexDirection: "column", position: 'relative' }}>
          {error && (
            <div className="absolute top-4 left-1/2 -translate-x-1/2 z-50 w-full max-w-2xl px-4">
              <div className="bg-red-500/90 backdrop-blur-sm text-white px-4 py-3 rounded-lg flex items-center gap-3 shadow-lg">
                <AlertCircle size={20} />
                <span className="text-sm font-medium">{error}</span>
                <button onClick={() => setError(null)} className="ml-auto text-white/70 hover:text-white">✕</button>
              </div>
            </div>
          )}
          <div className="flex-1 overflow-y-auto p-4 space-y-6">
            {!activeChatId ? (
              <div className="h-full flex flex-col items-center justify-center text-center p-6">
                <div className="w-16 h-16 rounded-2xl flex items-center justify-center mb-6 shadow-xl" style={{backgroundColor: '#ef6f61'}}>
                  <Bot size={32} className="text-white" />
                </div>
                <h1 className="text-3xl font-bold mb-2 text-gray-800">How can I help you today?</h1>
                <p className="text-gray-500 max-w-md text-sm">
                  Your private, local AI assistant. No data leaves your laptop.
                </p>
              </div>
            ) : isMessagesLoading ? (
              <div className="h-full min-h-[300px] flex items-center justify-center">
                <div className="flex items-center gap-3 rounded-xl bg-white border border-gray-100 px-5 py-4 text-sm text-gray-500 shadow-sm">
                  <Loader2 size={18} className="animate-spin text-[#ef6f61]" />
                  Loading messages...
                </div>
              </div>
            ) : (
              <div className="max-w-3xl mx-auto w-full py-8 px-4 space-y-6">
                {messages.map((msg, i) => (
                  <div key={i} className={`flex gap-4 p-6 rounded-2xl transition-all ${msg.role === 'assistant' ? 'bg-white shadow-sm border border-gray-100' : 'bg-transparent'}`}>
                    <div className={`w-9 h-9 rounded-lg flex items-center justify-center shrink-0 shadow-sm ${msg.role === 'assistant' ? 'bg-green-600' : 'bg-blue-600'}`}>
                      {msg.role === 'assistant' ? <Bot size={20} className="text-white" /> : <User size={20} className="text-white" />}
                    </div>
                    <div className="flex-1 prose prose-slate max-w-none">
                      <p className="text-gray-700 leading-relaxed whitespace-pre-wrap">{msg.content}</p>
                    </div>
                  </div>
                ))}
                {isLoading && (
                  <div className="flex gap-4 p-6 rounded-2xl bg-white shadow-sm border border-gray-100">
                    <div className="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 bg-green-600 shadow-sm">
                      <Bot size={20} className="text-white" />
                    </div>
                    <div className="flex items-center gap-2 text-sm text-gray-500">
                      <Loader2 size={17} className="animate-spin text-[#ef6f61]" />
                      Thinking...
                    </div>
                  </div>
                )}
                <div ref={messagesEndRef} />
              </div>
            )}
          </div>
          <div className="p-3 sm:p-4 lg:p-6 bg-gradient-to-t from-background-default via-background-default to-transparent">
            <div className="flex justify-center w-full">
              <Box
                sx={{
                  position: 'relative',
                  display: 'flex',
                  alignItems: 'center',
                  gap: 1,
                  borderRadius: 4,
                  border: '1px solid #e5e7eb',
                  bgcolor: 'white',
                  px: 2,
                  py: 1,
                  boxShadow: '0 10px 15px -3px rgba(0, 0, 0, 0.1)',
                  transition: 'all 0.2s',
                  width: '100%',
                  maxWidth: '768px' // This is the 3xl width in pixels
                }}
              >
                <input
                  value={input}
                  onChange={(e) => setInput(e.target.value)}
                  onKeyDown={(e) => e.key === 'Enter' && handleSend()}
                  placeholder="Message Local AI..."
                  style={{
                    flex: 1,
                    border: 'none',
                    outline: 'none',
                    fontSize: '14px',
                    color: '#1e2c36',
                    background: 'transparent'
                  }}
                />
                <Button
                  onClick={handleSend}
                  disabled={isLoading || !input.trim()}
                  sx={{
                    minWidth: 44,
                    height: 44,
                    borderRadius: 3,
                    bgcolor: '#ef6f61',
                    color: 'white',
                    '&:hover': { bgcolor: '#e35e4e' },
                    '&:disabled': { bgcolor: '#d1d5db' }
                  }}
                >
                  {isLoading ? <Loader2 size={18} className="animate-spin" /> : <Send size={18} />}
                </Button>
              </Box>
            </div>
            <p className="text-center text-[10px] text-gray-400 mt-4 uppercase tracking-widest">
              Ollama Llama3 • Localhost • Private
            </p>
          </div>
        </Box>
      </Box>
    </ThemeProvider>
  );
}
